# ==============================================================================
# RVITM PLACEMENTS — CENTRAL DOCKER COMPOSE CONFIGURATION (.env)
# ==============================================================================
# Copy this file to '.env' at the root of the project:
#   cp .env.example .env
#
# Docker Compose will automatically read from this root .env file to inject
# environment variables into all containers (backend, frontend, scraper, bot).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas or local MongoDB instance)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=vtu_database

# ------------------------------------------------------------------------------
# 2. AI SERVICES (Google Gemini)
# ------------------------------------------------------------------------------
# Google Gemini API key used by Backend and WhatsApp Bot to parse placement notices
# Get one at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. SPC COORDINATOR AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
ADMIN_ID=your_admin_id
# Password used by internal services/scraper
ADMIN_PASSWORD=your_admin_password
# bcrypt hash for SPC Admin password verification on the web portal
# Generate a new hash with: node backend/scripts/generate-hash.js "your_password"
ADMIN_PW_HASH=your_admin_pw_hash
# A long random string to sign and verify JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_change_in_production

# ------------------------------------------------------------------------------
# 4. GOOGLE CALENDAR SYNCHRONIZATION (Optional)
# ------------------------------------------------------------------------------
# Google Cloud Service Account credentials with Calendar API access
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION & GOOGLE OAUTH
# ------------------------------------------------------------------------------
# Backend API Base URL (Leave empty when using Docker Nginx reverse proxy)
VITE_API_BASE_URL=

# Google OAuth 2.0 Web Client ID (Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Institutional Google Spreadsheets & Drive Links
VITE_SHEET_BLACKLISTED_URL=https://docs.google.com/spreadsheets/
VITE_DRIVE_PLACEMENT_URL=https://drive.google.com/drive/
VITE_SHEET_STUDENTS_DB_URL=https://docs.google.com/spreadsheets/d/your_students_db_sheet_id/edit?usp=sharing
VITE_SHEET_PLACED_DATA_URL=https://docs.google.com/spreadsheets/d/your_placed_data_sheet_id/edit?usp=sharing
VITE_SHEET_PLACED_DATA_EMBED_URL=https://docs.google.com/spreadsheets/d/your_placed_data_sheet_id/htmlembed?widget=true&headers=false

# ------------------------------------------------------------------------------
# 6. WHATSAPP BOT CONFIGURATION
# ------------------------------------------------------------------------------
# Target WhatsApp Groups:
# Use '*' to listen to all groups (Discovery Mode)
# Or specify comma-separated group names or JIDs: "Placement 2027,120363389271@g.us"
ALLOWED_GROUPS=*

# Set to 'true' to test notice parsing without writing events to the database
DRY_RUN=false
